{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(java:*)",
      "Bash(bash -c*)",
      "Bash(bash scripts/*)",
      "Bash(ls:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker version:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(xargs grep:*)",
      "mcp__idea__*",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/deploy.env)",
      "Read(**/deploy.*.env)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"mvn -q test-compile\"",
            "timeout": 150,
            "statusMessage": "Checking compilation..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  }
}
