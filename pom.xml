<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>dynamic-form-desktop</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>dynamic-form-desktop</name>
  <description>JavaFX desktop client for dynamic-form</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- api jar and testcontainers jar share the backend image's version: api X runs against image X -->
    <dynamic-form.version>1.0.0-SNAPSHOT</dynamic-form.version>
    <javafx.version>21.0.12</javafx.version>
    <snapfx.version>0.8.0</snapfx.version>
    <jackson.version>2.22.4</jackson.version>
    <gson.version>2.14.0</gson.version>
    <junit.version>5.14.4</junit.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Shared DTOs. The client defines no DTOs of its own. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>dynamic-form-api</artifactId>
      <version>${dynamic-form.version}</version>
    </dependency>

    <!-- Jackson 2; jsr310 is mandatory because FormDataDto.submittedAt is a LocalDateTime -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Installed from its GitHub release by scripts/install-snapfx.sh; not on Maven Central -->
    <dependency>
      <groupId>org.snapfx</groupId>
      <artifactId>snapfx-core</artifactId>
      <version>${snapfx.version}</version>
    </dependency>
    <!-- The SnapFX jar ships no POM, so its gson requirement is not transitive -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <!-- Brings Testcontainers and auth-server-testcontainers transitively -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>dynamic-form-testcontainers</artifactId>
      <version>${dynamic-form.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-failsafe-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx-maven-plugin.version}</version>
        <configuration>
          <mainClass>com.example.desktop.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>repsy</id>
      <url>https://repo.repsy.io/mvn/markoniemi/maven</url>
      <!-- the dynamic-form artifacts are published as 1.0.0-SNAPSHOT, and a <repository> has
           snapshots disabled by default -->
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>
</project>
