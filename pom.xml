<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>dynamic-form-desktop</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>dynamic-form-desktop</name>
  <description>JavaFX desktop client for dynamic-form</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- api jar and testcontainers jar share the backend image's version: api X runs against image X -->
    <dynamic-form.version>1.0.0-SNAPSHOT</dynamic-form.version>
    <javafx.version>21.0.12</javafx.version>
    <snapfx.version>0.8.0</snapfx.version>
    <jackson.version>2.22.4</jackson.version>
    <gson.version>2.14.0</gson.version>
    <junit.version>5.14.4</junit.version>
    <testfx.version>4.0.18</testfx.version>
    <monocle.version>21.0.2</monocle.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <download-maven-plugin.version>1.13.0</download-maven-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>

    <!-- The sha256 of snapfx-core-0.8.0-0.jar, from the release's own .sha256 sidecar. Pinned here
         rather than fetched beside the jar: a sidecar from the same release proves the download was
         not corrupted in transit, but not that the asset is the one this build was tested against.
         Bumping snapfx.version means replacing this digest too, or the build fails loudly. -->
    <snapfx.sha256>77c16fe87e795762aea4be0abb4ada12782503be1c9511c46b3e11b765354b3b</snapfx.sha256>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Shared DTOs. The client defines no DTOs of its own. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>dynamic-form-api</artifactId>
      <version>${dynamic-form.version}</version>
    </dependency>

    <!-- Jackson 2; jsr310 is mandatory because FormDataDto.submittedAt is a LocalDateTime -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Not on Maven Central; the install-snapfx profile below fetches it from its GitHub release -->
    <dependency>
      <groupId>org.snapfx</groupId>
      <artifactId>snapfx-core</artifactId>
      <version>${snapfx.version}</version>
    </dependency>
    <!-- The SnapFX jar ships no POM, so its gson requirement is not transitive -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <!-- Brings Testcontainers and auth-server-testcontainers transitively -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>dynamic-form-testcontainers</artifactId>
      <version>${dynamic-form.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- UI tests. Monocle is the headless JavaFX platform; its version tracks JavaFX's. -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>openjfx-monocle</artifactId>
      <version>${monocle.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- UI tests exist in both phases, so both run headless. Set here rather than expected
               on the command line, so plain `mvn verify` works locally and in CI. -->
          <systemPropertyVariables>
            <testfx.headless>true</testfx.headless>
            <glass.platform>Monocle</glass.platform>
            <monocle.platform>Headless</monocle.platform>
            <prism.order>sw</prism.order>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-failsafe-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <testfx.headless>true</testfx.headless>
            <glass.platform>Monocle</glass.platform>
            <monocle.platform>Headless</monocle.platform>
            <prism.order>sw</prism.order>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx-maven-plugin.version}</version>
        <configuration>
          <mainClass>com.example.desktop.App</mainClass>
        </configuration>
      </plugin>
      <!-- Runs Launcher: the stack in Docker plus the app, for manual work. Declared and pinned
           because the command is documented in three places; without this Maven resolved whatever
           version was newest the first time anyone ran it. Configured here so the documented
           command is `mvn test-compile exec:java` rather than three -D flags. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>com.example.desktop.Launcher</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>repsy</id>
      <url>https://repo.repsy.io/mvn/markoniemi/maven</url>
      <!-- the dynamic-form artifacts are published as 1.0.0-SNAPSHOT, and a <repository> has
           snapshots disabled by default -->
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <profiles>
    <!-- SnapFX is not on Maven Central, so it is fetched from its GitHub release and installed into
         the local repository before anything needs it. This replaces scripts/install-snapfx.sh, so
         a clean checkout builds with plain `mvn verify` and CI needs no extra step.

         The profile activates only when the jar is absent, which is what keeps every later build
         from touching the network. Two consequences worth knowing:

         - The activation path is literal. Maven interpolates only system properties and ${basedir}
           in <activation>, never project properties, so ${snapfx.version} cannot appear here and
           0.8.0 is spelled out. It has to be changed together with the snapfx.version property.
         - It assumes the default local repository location. With a custom <localRepository> the
           profile never activates on its own; run `mvn -Pinstall-snapfx initialize` once instead. -->
    <profile>
      <id>install-snapfx</id>
      <activation>
        <file>
          <missing>${user.home}/.m2/repository/org/snapfx/snapfx-core/0.8.0/snapfx-core-0.8.0.jar</missing>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.googlecode.maven-download-plugin</groupId>
            <artifactId>download-maven-plugin</artifactId>
            <version>${download-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>download-snapfx</id>
                <phase>initialize</phase>
                <goals>
                  <goal>wget</goal>
                </goals>
                <configuration>
                  <uri>https://github.com/Beowolve/SnapFX/releases/download/v${snapfx.version}/snapfx-core-${snapfx.version}-0.jar</uri>
                  <sha256>${snapfx.sha256}</sha256>
                  <outputDirectory>${project.build.directory}/snapfx</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-install-plugin</artifactId>
            <version>${maven-install-plugin.version}</version>
            <executions>
              <execution>
                <id>install-snapfx</id>
                <phase>initialize</phase>
                <goals>
                  <goal>install-file</goal>
                </goals>
                <configuration>
                  <file>${project.build.directory}/snapfx/snapfx-core-${snapfx.version}-0.jar</file>
                  <groupId>org.snapfx</groupId>
                  <artifactId>snapfx-core</artifactId>
                  <version>${snapfx.version}</version>
                  <packaging>jar</packaging>
                  <!-- The release ships a jar and a .sha256 and nothing else, so there is no POM to
                       install beside it. install-file generates a minimal one, which carries no
                       dependencies - that is why gson is declared directly above. -->
                  <generatePom>true</generatePom>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
